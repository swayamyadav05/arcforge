# --- Database ---
# Neon PostgreSQL — pooled URL for queries
DATABASE_URL="postgresql://user:password@host/arcforge?pgbouncer=true&sslmode=require"

# Neon PostgreSQL — direct URL for migrations
# Used by Prisma CLI only, not the runtime
DIRECT_URL="postgresql://user:password@direct-host/arcforge?sslmode=require"

# --- AI ---
# Anthropic Claude API key — used for arc generation
ANTHROPIC_API_KEY="sk-ant-..."

# --- Auth ---
# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-here"

# Better Auth base URL — use http://localhost:3000 for dev
BETTER_AUTH_URL="http://localhost:3000"

# --- Email ---
# Resend API key — for magic link emails
RESEND_API_KEY="re_..."

# Resend sending address — must be verified domain in Resend
AUTH_RESEND_FROM="arc@arcforge.me"

# --- App ---
# Public app URL — used for share URL construction
# Set to https://arcforge.me in production
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Analytics ---
# PostHog project API key
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Error Tracking ---
# Sentry DSN — from Sentry project settings
SENTRY_DSN="https://..."
SENTRY_AUTH_TOKEN="sntrys_..."