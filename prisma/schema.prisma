// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ARC SERIES — Sprint 2
// ============================================================
// The series is the container for a user's ongoing narrative.
// One user can have multiple active or archived series —
// each series is an independent story arc with its own
// characters, wounds, and trajectory. Starting a new series
// doesn't affect existing ones.

model ArcSeries {
  id     String @id @default(cuid())
  userId String @map("user_id")

  // The current episode number in this series.
  // Starts at 1 when the series is created.
  // Incremented after each successful episode generation.
  currentEpisode Int @default(1) @map("current_episode")

  // When was the most recent episode generated.
  // Used to calculate whether the 7-day window for
  // Episode N+1 generation has passed.
  lastEpisodeAt DateTime @default(now()) @map("last_episode_at")

  // Series lifecycle status.
  // active: user can continue generating episodes
  // archived: user started a new series but kept this one
  status ArcSeriesStatus @default(active)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodes    Arc[]
  reflections Reflection[]
  storyBible  StoryBible?
  storyEvents StoryEvent[]

  @@index([userId])
  @@index([userId, status])
  @@map("arc_series")
}

enum ArcSeriesStatus {
  active
  archived

  @@map("arc_series_status")
}

// ============================================================
// ARC (EPISODE) — Updated for Sprint 2
// ============================================================

model Arc {
  // We use String for the id instead of the default Int or UUID.
  // This is our NanoID — short, URL-safe, human-shareable.
  id String @id

  // --- Sprint 2 additions ---
  // Every arc now belongs to a series.
  // Episode 1 creates the series, subsequent episodes link to it.
  // Nullable during migration — backfilled in a one-time script.
  seriesId String? @map("series_id")

  // The episode's position within its series.
  // Derived from ArcSeries.currentEpisode at time of creation.
  episodeNumber Int? @map("episode_number")

  // Actual days elapsed since the previous episode.
  // Passed into Episode 2+ prompts as metadata so Claude
  // knows if the user returned on day 7 or day 23.
  // Null for Episode 1 of any series.
  daysSincePrev Int? @map("days_since_prev")

  // --- Existing fields ---
  // The raw answers the user typed.
  // Episode 1: the 8 awakening questions
  // Episode 2+: the reflection answers from the previous window
  answers Json

  // Claude's full generated response.
  arcData Json @map("arc_data")

  // For rate limiting cross-reference.
  ipAddress String @map("ip_address")

  // FingerprintJS browser fingerprint for rate limit hybrid.
  fingerprint String?

  // userId is nullable for Phase 1 backward compatibility.
  // In Sprint 2 account-first flow, this is always set on new arcs.
  userId String? @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user   User?      @relation(fields: [userId], references: [id])
  series ArcSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, episodeNumber])
  @@index([seriesId])
  @@index([userId])
  @@map("arcs")
}

// ============================================================
// REFLECTION — Sprint 2
// ============================================================
// The in-progress reflection a user writes during the
// 7-day window before generating the next episode.
// Auto-saved as they type, editable throughout the window.
// One active reflection per series at a time.
// Deleted after successful episode generation.

model Reflection {
  id       String @id @default(cuid())
  seriesId String @unique @map("series_id")

  // The reflection answers keyed by question id.
  // Stored as JSON for flexibility — the reflection questions
  // may evolve per episode without requiring schema changes.
  answers Json

  // When the user marked the reflection as ready for generation.
  // Null while still drafting.
  submittedAt DateTime? @map("submitted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  series ArcSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@map("reflections")
}

// ============================================================
// STORY BIBLE — Sprint 2
// ============================================================
// The compressed narrative state for a series.
// This is the canonical "what is true about the story so far."
// Updated after every episode generation via state_delta
// from the Claude response.

model StoryBible {
  id       String @id @default(cuid())
  seriesId String @unique @map("series_id")

  // The full bible as structured JSON. Shape:
  //   world: { genre, tone, hard_rules }
  //   characters: map keyed by stable id with:
  //     name, archetype, description, voice, status,
  //     wounds[], possessions[], knowledge_state[]
  //   relationships: edges between characters
  //   unresolved_threads: open narrative threads
  //   timeline: one-sentence per episode
  //   motifs: recurring themes
  //   established_facts: canonical facts with:
  //     fact, established_episode, last_changed_episode,
  //     valid_until (null if still valid)
  //   emotional_arc: { start, current, target }
  //   style_guide: voice and tone rules
  bible Json

  // Approximate token count of the bible.
  // Used for cache budgeting — if bible exceeds threshold,
  // trigger a compaction pass to summarize older entries.
  tokenCount Int @default(0) @map("token_count")

  // Optimistic lock version for safe concurrent updates.
  version Int @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  series ArcSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@map("story_bibles")
}

// ============================================================
// STORY EVENT — Sprint 2
// ============================================================
// Append-only event log. Every episode generation appends
// events describing what happened in narrative terms.
// The bible is the current state — this is the full history.
// Enables time-travel debugging and safe regeneration.

model StoryEvent {
  id            String @id @default(cuid())
  seriesId      String @map("series_id")
  episodeNumber Int    @map("episode_number")

  // Event type discriminator. Common types:
  //   wound_surfaced, wound_deepened, wound_healed
  //   promise_made, promise_kept, promise_broken
  //   relationship_formed, relationship_changed
  //   secret_revealed, secret_kept
  //   mission_assigned, mission_completed, mission_avoided
  eventType String @map("event_type")

  // Full event payload as JSON. Each event type has
  // its own shape — the TypeScript reducer handles
  // applying the event to the bible.
  payload Json

  createdAt DateTime @default(now()) @map("created_at")

  series ArcSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([seriesId])
  @@index([seriesId, episodeNumber])
  @@map("story_events")
}

// ============================================================
// RATE LIMIT — unchanged
// ============================================================

model RateLimit {
  id          String   @id @default(cuid())
  ipAddress   String   @map("ip_address")
  fingerprint String?
  arcCount    Int      @default(0) @map("arc_count")
  windowStart DateTime @map("window_start")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([ipAddress])
  @@index([fingerprint])
  @@map("rate_limits")
}

// ============================================================
// API USAGE LOG — unchanged
// ============================================================

model ApiUsageLog {
  id           String   @id @default(cuid())
  arcId        String   @map("arc_id")
  tokensInput  Int      @map("tokens_input")
  tokensOutput Int      @map("tokens_output")
  costUsd      Float    @map("cost_usd")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([arcId])
  @@map("api_usage_logs")
}

// ============================================================
// USER — Updated for Sprint 2
// ============================================================

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions Session[]
  accounts Account[]
  arcs     Arc[]
  series   ArcSeries[] // Sprint 2 addition

  @@map("users")
}

// ============================================================
// SESSION, ACCOUNT, VERIFICATION — unchanged (Better Auth)
// ============================================================

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}
